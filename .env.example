PORT=4000
# Optional: defaults to mongodb://127.0.0.1:27017/mini_crm
MONGODB_URI=mongodb://127.0.0.1:27017/mini_crm
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
ADMIN_NAME=Workspace Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SEED_DEMO_DATA=true

# Set this in client builds only when the API is hosted on a separate origin.
# VITE_API_URL=https://api.example.com
